# Auto detect text files and perform LF normalization
* text=auto

# v3 and v3-ms-store carry different Dumper-7 SDK dumps (Steam and Microsoft Store).
# On merge, keep this branch's SDK instead of taking the other branch's.
# Needs `git config merge.ours-sdk.driver true` once per clone; git does not store merge drivers here.
Source/Third-Party/Dumper-7/CppSDK/** merge=ours-sdk
